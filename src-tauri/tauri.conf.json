{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Download Manager",
  "version": "0.2.0",
  "identifier": "dev.hasiiib.downloadmanager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Download Manager",
        "width": 1180,
        "height": 760,
        "minWidth": 840,
        "minHeight": 560,
        "backgroundColor": "#0b1020"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "linux": {
      "deb": {
        "depends": [
          "aria2"
        ]
      }
    },
    "icon": [
      "icons/icon.png"
    ]
  }
}
